// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
	"project_panel": {
		"dock": "left",
	},
	"outline_panel": {
		"dock": "left",
	},
	"collaboration_panel": {
		"dock": "left",
	},
	"git_panel": {
		"dock": "left",
	},
	"agent": {
		"dock": "right",
		"default_profile": "ask",
		"single_file_review": false,
		"model_parameters": [],
		"inline_assistant_model": {
			"provider": "zed.dev",
			"model": "claude-sonnet-4",
		},
		"default_model": {
			"provider": "zed.dev",
			"model": "claude-sonnet-4",
		},
	},
	"debugger": {
		"dock": "left",
	},
	"base_keymap": "VSCode",
	"buffer_font_family": "SF Mono",
	"buffer_font_size": 14,
	"buffer_line_height": { "custom": 1.8 },
	"format_on_save": "off",
	"hard_tabs": true,
	"languages": {
		"TypeScript": {
			"formatter": {
				"external": {
					"command": "prettier",
					"arguments": ["--stdin-filepath", "{buffer_path}"],
				},
			},
		},
		"TSX": {
			"formatter": {
				"external": {
					"command": "prettier",
					"arguments": ["--stdin-filepath", "{buffer_path}"],
				},
			},
		},
		"JavaScript": {
			"formatter": {
				"external": {
					"command": "prettier",
					"arguments": ["--stdin-filepath", "{buffer_path}"],
				},
			},
		},
	},
	"preview_tabs": {
		"enabled": false,
		"enable_preview_from_file_finder": false,
	},
	"show_whitespaces": "boundary",
	"theme": {
		"light": "Solarized Light",
		"dark": "Solarized Dark",
		"mode": "system",
	},
	"tab_size": 2,
	"telemetry": {
		"diagnostics": false,
		"metrics": false,
	},
	"ui_font_family": "SF Mono",
	"vim_mode": true,
}
